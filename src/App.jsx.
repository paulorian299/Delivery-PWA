
import { useState } from 'react';

const produtos = [
  { id: 1, nome: 'Hambúrguer Clássico', descricao: 'Pão, carne, queijo e salada', preco: 22.90, emoji: '🍔' },
  { id: 2, nome: 'Pizza de Calabresa', descricao: 'Calabresa, queijo e molho especial', preco: 39.90, emoji: '🍕' },
  { id: 3, nome: 'Batata Frita', descricao: 'Porção crocante', preco: 15.00, emoji: '🍟' },
  { id: 4, nome: 'Refrigerante', descricao: 'Lata 350 ml', preco: 6.00, emoji: '🥤' }
];

export default function App() {
  const [carrinho, setCarrinho] = useState([]);

  function adicionar(produto) {
    setCarrinho([...carrinho, produto]);
  }

  const total = carrinho.reduce((soma, item) => soma + item.preco, 0);

  return (
    <main style={{ background: '#f5f5f5', minHeight: '100vh', fontFamily: 'Arial', color: '#222' }}>
      <header style={{ background: '#171717', color: 'white', padding: 24 }}>
        <h1>🍔 Minha Loja</h1>
        <p>Seu delivery favorito!</p>
      </header>

      <section style={{ padding: 20 }}>
        <h2>Nosso cardápio</h2>

        {produtos.map(produto => (
          <article key={produto.id} style={{
            background: 'white',
            padding: 16,
            marginBottom: 12,
            borderRadius: 12,
            display: 'flex',
            alignItems: 'center',
            gap: 12
          }}>
            <span style={{ fontSize: 38 }}>{produto.emoji}</span>

            <div style={{ flex: 1 }}>
              <strong>{produto.nome}</strong>
              <p style={{ fontSize: 13, color: '#666' }}>{produto.descricao}</p>
              <strong>R$ {produto.preco.toFixed(2).replace('.', ',')}</strong>
            </div>

            <button onClick={() => adicionar(produto)} style={{
              background: '#16a34a',
              color: 'white',
              border: 0,
              borderRadius: 8,
              padding: 10
            }}>
              Adicionar
            </button>
          </article>
        ))}
      </section>

      <footer style={{
        background: '#171717',
        color: 'white',
        padding: 20,
        position: 'sticky',
        bottom: 0
      }}>
        <strong>🛒 Carrinho: {carrinho.length} item(ns)</strong>
        <p>Total: R$ {total.toFixed(2).replace('.', ',')}</p>
      </footer>
    </main>
  );
}
